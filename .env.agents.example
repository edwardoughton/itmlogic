# Genoa autonomous agent system — example configuration.
# Copy to .env.agents and fill in.  Loaded by the agent scripts when run
# locally; GitHub Actions reads the equivalent from repo secrets/vars.

# ───── Deploy authority ─────────────────────────────────────────────
# report_only        — agents read + write reports, never push code, never deploy
# pr_only            — agents may open PRs but never auto-merge or deploy   [DEFAULT]
# safe_prod_write    — agents may merge + deploy, gated by every script in agents/scripts/
AGENT_DEPLOY_MODE=pr_only

# ───── Budget knobs ─────────────────────────────────────────────────
# Token budget mode:
#   conservative | balanced | deep | max_safe
AGENT_TOKEN_MODE=balanced

# Compute orchestration mode:
#   local_only | parallel_agents | burst_compute | heavy_analysis
COMPUTE_MODE=parallel_agents

# ───── Deploy gating ────────────────────────────────────────────────
AGENT_MAX_DEPLOYS_PER_DAY=2
AGENT_ALLOWED_DEPLOY_WINDOW_START=13        # UTC hour [0-23]
AGENT_ALLOWED_DEPLOY_WINDOW_END=22          # UTC hour [0-23]
AGENT_REQUIRE_MULTI_AGENT_APPROVAL=true

# ───── Compute caps ─────────────────────────────────────────────────
MAX_WORKERS=4
MAX_PARALLEL_AGENTS=4
MAX_CPU_PERCENT=80
MAX_MEMORY_PERCENT=70
ENABLE_BURST_WORKERS=false
ENABLE_HEAVY_ANALYSIS=false
MAX_MONTHLY_COMPUTE_BUDGET=200              # USD; informational cap

# ───── DigitalOcean ─────────────────────────────────────────────────
DIGITALOCEAN_ACCESS_TOKEN=
DIGITALOCEAN_APP_ID=ee09120d-dee3-43b3-bc85-da39d3f43ad2
PRODUCTION_URL=https://genoaiq.com

# ───── GitHub ───────────────────────────────────────────────────────
GITHUB_TOKEN=

# ───── Optional: LLM runner ─────────────────────────────────────────
# When set to 'claude-cli' AND the `claude` CLI is installed on PATH,
# run-agent.sh invokes it directly.  Otherwise the script prepares the
# working context for an operator-driven Claude Code session.
AGENT_RUNNER=
